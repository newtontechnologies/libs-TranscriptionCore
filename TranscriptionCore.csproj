<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>beey.trsx</PackageId>
    <Version>$(TRANSCRIPTION_CORE_NUGET_VERSION)</Version>
    <Authors>Newton Technologies</Authors>
    <Company>Newton Technologies</Company>
    <RepositoryUrl>https://github.com/newtontechnologies/libs-TranscriptionCore</RepositoryUrl>
    <OutputType>library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TranscriptionCore</AssemblyName>
    <RootNamespace>TranscriptionCore</RootNamespace>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Update="TRSXSchema3.xsd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
